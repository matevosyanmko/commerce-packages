{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client"],
    // Typecheck against package SOURCE, matching the vite aliases in
    // .storybook/main.ts — otherwise the editor reads dist and disagrees with
    // what Storybook actually renders.
    "paths": {
      "@wm-storefront/ui": ["../packages/ui/src/index.ts"],
      "@wm-storefront/ui/*": ["../packages/ui/src/*"],
      "@wm-storefront/commerce-ui": ["../packages/commerce-ui/src/index.ts"],
      "@wm-storefront/commerce-ui/*": ["../packages/commerce-ui/src/*"],
      "@wm-storefront/commerce-core": ["../packages/commerce-core/src/index.ts"],
      "@wm-storefront/commerce-core/*": ["../packages/commerce-core/src/*"]
    }
  },
  "include": [".storybook", "src", "stories"]
}
