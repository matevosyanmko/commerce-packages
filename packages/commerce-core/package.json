{
  "name": "@gucco/commerce-core",
  "version": "0.2.1",
  "description": "Backend-neutral commerce seam (catalog, cart, orders, customer) shared across storefronts. Zero brand data — catalog and store config are injected.",
  "keywords": [
    "commerce",
    "ecommerce",
    "medusa",
    "storefront",
    "typescript"
  ],
  "license": "MIT",
  "author": "Mko Matevosyan <matevosyanmko@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matevosyanmko/commerce-packages.git",
    "directory": "packages/commerce-core"
  },
  "homepage": "https://github.com/matevosyanmko/commerce-packages/tree/main/packages/commerce-core#readme",
  "bugs": {
    "url": "https://github.com/matevosyanmko/commerce-packages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "pack:check": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@medusajs/js-sdk": "^2.17.2",
    "@medusajs/types": "^2.17.2",
    "@tanstack/zod-adapter": "^1.167.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
