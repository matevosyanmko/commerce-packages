{
  "name": "@gucco/commerce-ui",
  "version": "0.1.1",
  "description": "Shared commerce components + providers. Brand values injected via StorefrontProvider.",
  "keywords": [
    "react",
    "commerce",
    "ecommerce",
    "medusa",
    "storefront"
  ],
  "license": "MIT",
  "author": "Mko Matevosyan <matevosyanmko@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matevosyanmko/commerce-packages.git",
    "directory": "packages/commerce-ui"
  },
  "homepage": "https://github.com/matevosyanmko/commerce-packages/tree/main/packages/commerce-ui#readme",
  "bugs": {
    "url": "https://github.com/matevosyanmko/commerce-packages/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "bun run build",
    "pack:check": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@gucco/commerce-core": "^0.1.1",
    "@gucco/ui": "^0.1.1"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "@tanstack/react-query": ">=5",
    "@tanstack/react-router": ">=1.170",
    "sonner": ">=2",
    "lucide-react": ">=0.500"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.8.3",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "sonner": "^2.0.7",
    "lucide-react": "^0.575.0"
  }
}
